@page "/"
@using FrontEnd.Data.jogoNumero
@inject JogoNumeroClient JogoNumeroClient




<div class="jogo-box">
    <h1>🤖 Jogo da Adivinhação</h1>
    <p class="text">Tente descobrir um número: de 1 a 100</p>

    @if (jogoFinalizado)
    {
        <!-- Botão que aparece apenas quando o jogo acaba -->
        <p class="sucesso">🎉 Fim de jogo!</p>
        <button @onclick="ReiniciarJogo" class="btn-reiniciar">Jogar Novamente</button>
    }
    else
    {
        <!-- Interface padrão de palpites -->
        <div class="input-area">
            <input type="number" @bind="palpiteUsuario" placeholder="Digite de 1 a 100" />
            <button @onclick="DarPalpiteNoServidor" class="btn-reiniciar">Dar palpite</button>
        </div>

    }

   <div class="message">
     <p class="text">@mensagem</p>
   </div>
</div>


@code {
    // Unifiquei as variáveis para evitar duplicidade (você tinha _jogoId e jogoId)
    private string? jogoId;
    private int? palpiteUsuario; 
    private string mensagem = "Conectando ao servidor...";
    private bool jogoFinalizado;
    
    // Esse método roda uma única vez quando a página abre
    protected override async Task OnInitializedAsync()
    {
        // Chamamos APENAS o ReiniciarJogo, pois ele já tem toda a lógica 
        // de falar com a API e salvar o jogoId!
        await ReiniciarJogo();
    }

    private async Task DarPalpiteNoServidor()
    {
        if (palpiteUsuario == null)
        {
            mensagem = "Por favor, digite um número antes de enviar.";
            return;
        }

        if (string.IsNullOrEmpty(jogoId))
        {
            mensagem = "Erro, o jogo não foi iniciado corretamente.";
            return;
        }

        try
        {
            var resposta = await JogoNumeroClient.enviarPalpiteAsync(jogoId, palpiteUsuario.Value);

            if (resposta != null)
            {
                mensagem = resposta.Mensagem;

                // DICA: Certifique-se de que no Backend o status vem escrito exatamente como "acertou"
                if (resposta.Status?.ToLower() == "acertou")
                {
                    jogoFinalizado = true;
                }
            }
            palpiteUsuario = null; 
        }
        catch (Exception)
        {
            mensagem = "Erro ao se comunicar com o servidor.";
        }
    }

    private async Task ReiniciarJogo()
    {
        palpiteUsuario = null;
        jogoFinalizado = false;
        mensagem = "Gerando novo número secreto no servidor...";

        try
        {
            var novoJogo = await JogoNumeroClient.inicarJogoAsync();

            if (novoJogo != null && !string.IsNullOrEmpty(novoJogo.JogoId))
            {
                jogoId = novoJogo.JogoId;
                mensagem = "Novo jogo iniciado! Dê o seu palpite de 1 a 100. 🍀";
            }
            else
            {
                mensagem = "Ops, o servidor respondeu mas não gerou um ID válido.";
            }
        }
        catch (Exception ex)
        {
            // Adicionei o ex.Message temporariamente para você ver o erro real no console se falhar
            Console.WriteLine($"Erro na API: {ex.Message}");
            mensagem = "Erro de conexão. A API do Backend está ligada?";
        }
    }
}